{"item_id": "B000ENQT3U", "title": "Aqua Sphere Aqua Dry Towel", "description": "Ultra absorbent towel allows you to dry off quickly and easily and is the perfect size for taking to the pool or gym.", "text": "Aqua Sphere Aqua Dry Towel Ultra absorbent towel allows you to dry off quickly and easily and is the perfect size for taking to the pool or gym.", "image_url": "http://ecx.images-amazon.com/images/I/31MSAB444DL._SX300_.jpg", "image_path": "data/images/sports/B000ENQT3U.jpg", "metadata": {"brand": "Aqua Sphere", "categories": [["Sports & Outdoors", "Outdoor Gear", "Camping & Hiking", "Personal Care", "Towels"]], "price": 8.01}}
