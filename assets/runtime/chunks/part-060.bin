{"item_id": "B000ND7EG2", "title": "Hunter's Specialties Fresh Earth Cover Scent Wafers (9 Pack)", "description": "Fresh Earth Cover Scent Wafers (9 Pack). Includes nine safety pins to clip to your clothing or hang on nearby branches.", "text": "Hunter's Specialties Fresh Earth Cover Scent Wafers (9 Pack) Fresh Earth Cover Scent Wafers (9 Pack). Includes nine safety pins to clip to your clothing or hang on nearby branches.", "image_url": "http://ecx.images-amazon.com/images/I/51H0KQtjdLL._SX300_.jpg", "image_path": "data/images/sports/B000ND7EG2.jpg", "metadata": {"brand": "Hunter&#39;s Specialties", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Scents & Scent Eliminators", "Scents"]], "price": 18.14}}
{"item_id": "B000ND7EJ4", "title": "Summit Treestands Rapid Climb Stirrups", "description": "Eliminate your toe straps. Just rest your heel on the bungee, stretch it back and insert your foot in the stirrup. Stirrups will fit any of our aluminum stands with 1-Inch square tubing. They also fit many commercially available stands.", "text": "Summit Treestands Rapid Climb Stirrups Eliminate your toe straps. Just rest your heel on the bungee, stretch it back and insert your foot in the stirrup. Stirrups will fit any of our aluminum stands with 1-Inch square tubing. They also fit many commercially available stands.", "image_url": "http://ecx.images-amazon.com/images/I/41VGOzdGfYL._SY300_.jpg", "image_path": "data/images/sports/B000ND7EJ4.jpg", "metadata": {"brand": "Summit Treestands", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Tree Stands & Accessories", "Tree Stand Accessories"]], "price": 22.61}}
