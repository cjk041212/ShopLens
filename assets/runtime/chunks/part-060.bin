{"item_id": "B00018ADUS", "title": "Grace USA Gun Care Brass Pin Punch Set", "description": "This high quality brass 8 piece punch set is ideal for the gentle removal of pins from your most favorite and older guns, and for the most important or critical cases where softness and gentleness matter.", "text": "Grace USA Gun Care Brass Pin Punch Set This high quality brass 8 piece punch set is ideal for the gentle removal of pins from your most favorite and older guns, and for the most important or critical cases where softness and gentleness matter.", "image_url": "http://ecx.images-amazon.com/images/I/51OuMEpk6vL._SX300_.jpg", "image_path": "data/images/sports/B00018ADUS.jpg", "metadata": {"brand": "Grace USA", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Gun Maintenance", "Gunsmithing Tools"]], "price": 35.95}}
{"item_id": "B00018ADWQ", "title": "Grace USA 4-Ounce Brass Hammer", "description": "This beautifully crafted hammer is a solid 360 brass, machine turned and hand polished head and had a seasoned hickory handle.", "text": "Grace USA 4-Ounce Brass Hammer This beautifully crafted hammer is a solid 360 brass, machine turned and hand polished head and had a seasoned hickory handle.", "image_url": "http://ecx.images-amazon.com/images/I/31tbgZSe0QL._SY300_.jpg", "image_path": "data/images/sports/B00018ADWQ.jpg", "metadata": {"brand": "Grace USA", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Gun Maintenance", "Gunsmithing Tools"]], "price": 13.59}}
