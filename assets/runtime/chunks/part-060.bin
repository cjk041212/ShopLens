{"item_id": "B0037YQTWY", "title": "SwimWays Light-Up Beach Ball", "description": "With the Swim Ways Light-Up Beach Ball, nighttime comes alive. Impact-activated, the Light-Up Beach Ball flashes red, blue and green. Super bright LEDs are included.", "text": "SwimWays Light-Up Beach Ball With the Swim Ways Light-Up Beach Ball, nighttime comes alive. Impact-activated, the Light-Up Beach Ball flashes red, blue and green. Super bright LEDs are included.", "image_url": "http://ecx.images-amazon.com/images/I/51aszFp6NDL._SX300_.jpg", "image_path": "data/images/sports/B0037YQTWY.jpg", "metadata": {"brand": "Swim Ways", "categories": [["Sports & Outdoors", "Leisure Sports & Game Room", "Outdoor Games & Activities", "Balls", "Playground Balls"]], "price": 3.57}}
