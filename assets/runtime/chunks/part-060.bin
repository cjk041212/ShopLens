 deadly.", "image_url": "http://ecx.images-amazon.com/images/I/416l8mf29qL._SY300_.jpg", "image_path": "data/images/sports/B004YWK74E.jpg", "metadata": {"brand": "Cold Steel", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Hunting & Tactical Knives", "Hunting Knives", "Fixed Blade Hunting Knives"]], "price": 48.24}}
