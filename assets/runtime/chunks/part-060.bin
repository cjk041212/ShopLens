{"item_id": "B000YU1WYO", "title": "Camelbak Thermal Control Kit", "description": "Converts any CamelBak system for extreme winter and summer conditions. Includes Big Bite Valve mouthpiece, mouthpiece cover, insulated tube cover and 42\" delivery tube.", "text": "Camelbak Thermal Control Kit Converts any CamelBak system for extreme winter and summer conditions. Includes Big Bite Valve mouthpiece, mouthpiece cover, insulated tube cover and 42\" delivery tube.", "image_url": "http://ecx.images-amazon.com/images/I/41fLPv4CFpL._SX300_.jpg", "image_path": "data/images/sports/B000YU1WYO.jpg", "metadata": {"categories": [["Sports & Outdoors", "Outdoor Gear", "Camping & Hiking", "Backpacks & Bags", "Hydration Packs"]], "price": 24.99}}
