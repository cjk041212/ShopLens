{"item_id": "B0017AVAME", "title": "Mirrycle Incredibell Saturn Bicycle Bell", "description": "Incredibell Saturn Bells offer a ringer that rings and rings and rings. Dome Diameter: 48.3mm (1.9\")", "text": "Mirrycle Incredibell Saturn Bicycle Bell Incredibell Saturn Bells offer a ringer that rings and rings and rings. Dome Diameter: 48.3mm (1.9\")", "image_url": "http://ecx.images-amazon.com/images/I/41pO6KizYsL._SX300_.jpg", "image_path": "data/images/sports/B0017AVAME.jpg", "metadata": {"brand": "Mirrycle", "categories": [["Sports & Outdoors", "Cycling", "Kids' Bikes & Accessories", "Kids' Accessories"]], "price": 11.01}}
{"item_id": "B0017AWR6C", "title": "Mirrycle Incredibell Brass Solo Bicycle Bell", "description": "The beautifully resonant ring of solid brass. Available in solid brass and chrome-plated solid brass. Sounds a single ding. Dome Diameter: 33mm (1.3\"). Fits handlebars with 21.7mm - 24mm (.86\" - .95\") outside diameters.", "text": "Mirrycle Incredibell Brass Solo Bicycle Bell The beautifully resonant ring of solid brass. Available in solid brass and chrome-plated solid brass. Sounds a single ding. Dome Diameter: 33mm (1.3\"). Fits handlebars with 21.7mm - 24mm (.86\" - .95\") outside diameters.", "image_url": "http://ecx.images-amazon.com/images/I/31v5N2c%2BMeL._SY300_.jpg", "image_path": "data/images/sports/B0017AWR6C.jpg", "metadata": {"brand": "Mirrycle", "categories": [["Sports & Outdoors", "Cycling", "Kids' Bikes & Accessories", "Kids' Accessories"]], "price": 10.3}}
