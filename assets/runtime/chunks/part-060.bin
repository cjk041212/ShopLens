{"item_id": "B003SHBL00", "title": "Condor Deployment Bag", "description": "Condor Outdoor Products, Inc specialize in tactical vest, plate carrier, modular pouches, packs...etc. With over 20 years of experience in the tactical/outdoor gear industry, Condor offers all the essential gear for any mission while saving you money.", "text": "Condor Deployment Bag Condor Outdoor Products, Inc specialize in tactical vest, plate carrier, modular pouches, packs...etc. With over 20 years of experience in the tactical/outdoor gear industry, Condor offers all the essential gear for any mission while saving you money.", "image_url": "http://ecx.images-amazon.com/images/I/51pR3UuJOYL._SY300_.jpg", "image_path": "data/images/sports/B003SHBL00.jpg", "metadata": {"brand": "Condor", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Archery", "Accessories", "Bow Maintenance Accessories"]], "price": 17.95}}
