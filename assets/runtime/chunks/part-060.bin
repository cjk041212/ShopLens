{"item_id": "B004F3XJ3S", "title": "Storm Scuba Diving and Surfing Wetsuit Hanger - Black", "description": "This Storm hanger will hold heavy wet and dry suits and allow them to dry properly. Keep your gear off the floor to prevent damage.", "text": "Storm Scuba Diving and Surfing Wetsuit Hanger - Black This Storm hanger will hold heavy wet and dry suits and allow them to dry properly. Keep your gear off the floor to prevent damage.", "image_url": "http://ecx.images-amazon.com/images/I/41Nj7j2oSOL._SX300_.jpg", "image_path": "data/images/sports/B004F3XJ3S.jpg", "metadata": {"categories": [["Sports & Outdoors", "Boating & Water Sports", "Swimming"]], "price": 10.98}}
{"item_id": "B004F9CAGO", "title": "Eagle Flight 24 Inch Eagle Flight .40 Cal. Blowgun", "description": "24\" Aluminum .40c blowgun. Made from lightweight aircraft quality seamless tubing. Includes foam grip, Mouth and muzzle guard. High quality enamel paint. 2 accessories quivers included along with 8 target darts. Lifetime Mfg Warranty Made in USA!!!", "text": "Eagle Flight 24 Inch Eagle Flight .40 Cal. Blowgun 24\" Aluminum .40c blowgun. Made from lightweight aircraft quality seamless tubing. Includes foam grip, Mouth and muzzle guard. High quality enamel paint. 2 accessories quivers included along with 8 target darts. Lifetime Mfg Warranty Made in USA!!!", "image_url": "http://ecx.images-amazon.com/images/I/31NOtlkMByL._SY300_.jpg", "image_path": "data/images/sports/B004F9CAGO.jpg", "metadata": {"brand": "Bud K", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Airsoft, Air Guns & Slingshots"]], "price": 12.17}}
