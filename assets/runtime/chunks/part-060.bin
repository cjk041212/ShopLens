{"item_id": "B005XYGN2W", "title": "U.S. Divers Adult Magellan Purge LX Mask/Tucson LX Snorkel", "description": "2-Window silicone mask with silicone squeeze buckles & purge. Submersible snorkel with purge, built in safety whistle, flex section and silicone mouthpiece.", "text": "U.S. Divers Adult Magellan Purge LX Mask/Tucson LX Snorkel 2-Window silicone mask with silicone squeeze buckles & purge. Submersible snorkel with purge, built in safety whistle, flex section and silicone mouthpiece.", "image_url": "http://ecx.images-amazon.com/images/I/41p0PGgqCJL._SY300_.jpg", "image_path": "data/images/sports/B005XYGN2W.jpg", "metadata": {"brand": "U.S. Divers", "categories": [["Sports & Outdoors", "Boating & Water Sports", "Diving & Snorkeling", "Snorkeling Packages"]], "price": 27.95}}
