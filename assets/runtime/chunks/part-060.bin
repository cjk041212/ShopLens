{"item_id": "B000LGRZZG", "title": "Mckenzie 20950 Tuff Block Low Poundage Archery Target", "description": "The Mckenzie 20950 Tuff Block Low Poundage Archery Target is designed for anyone from backyard shooters to young archery enthusiasts shooting for the first time. Different sized targets on the different sides allow for variability in challenge level.", "text": "Mckenzie 20950 Tuff Block Low Poundage Archery Target The Mckenzie 20950 Tuff Block Low Poundage Archery Target is designed for anyone from backyard shooters to young archery enthusiasts shooting for the first time. Different sized targets on the different sides allow for variability in challenge level.", "image_url": "http://ecx.images-amazon.com/images/I/41OkvNnXbhL._SX300_.jpg", "image_path": "data/images/sports/B000LGRZZG.jpg", "metadata": {"brand": "Mckenzie", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Archery", "Targets"]], "price": 29.0}}
{"item_id": "B000LGZW8S", "title": "Nalgene HDPE Narrow Mouth Water Bottle", "description": "With their easy-drinking narrow mouth (38mm) these ultralight HDPE bottles are still a favorite.", "text": "Nalgene HDPE Narrow Mouth Water Bottle With their easy-drinking narrow mouth (38mm) these ultralight HDPE bottles are still a favorite.", "image_url": "http://ecx.images-amazon.com/images/I/41QJ9JMZ01L._SY300_.jpg", "image_path": "data/images/sports/B000LGZW8S.jpg", "metadata": {"categories": [["Sports & Outdoors", "Accessories", "Sports Water Bottles"]]}}
