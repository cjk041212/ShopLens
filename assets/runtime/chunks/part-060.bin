{"item_id": "B0018MIW04", "title": "ECOnscious 100% Organic Cotton Twill Corps Hat", "description": "Unstructured garment-washed, organic twill cap has a pre-curved visor and brass metal eyelets. 100% organic cotton twill Adjustable self-fabric back with tri-glide buckle.", "text": "ECOnscious 100% Organic Cotton Twill Corps Hat Unstructured garment-washed, organic twill cap has a pre-curved visor and brass metal eyelets. 100% organic cotton twill Adjustable self-fabric back with tri-glide buckle.", "image_url": "http://ecx.images-amazon.com/images/I/41dZ6qDvuOL._SX300_.jpg", "image_path": "data/images/sports/B0018MIW04.jpg", "metadata": {"brand": "econscious", "categories": [["Sports & Outdoors", "Clothing", "Men", "Accessories", "Hats & Caps", "Baseball Caps"]], "price": 9.93}}
