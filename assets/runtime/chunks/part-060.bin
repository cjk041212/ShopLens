{"item_id": "B00069PFKK", "title": "Stansport Back Packing Pad", "description": "Lightweight camping/backpacking pad made of closed cell foam insulation. Measures 72 by 19 by 3/8 inches (L x W x D). Keeps the cold and dampness away from your body. Straps keep pad rolled for storage and transit.", "text": "Stansport Back Packing Pad Lightweight camping/backpacking pad made of closed cell foam insulation. Measures 72 by 19 by 3/8 inches (L x W x D). Keeps the cold and dampness away from your body. Straps keep pad rolled for storage and transit.", "image_url": "http://ecx.images-amazon.com/images/I/41AlTuo78xL._SY300_.jpg", "image_path": "data/images/sports/B00069PFKK.jpg", "metadata": {"brand": "StanSport", "categories": [["Sports & Outdoors", "Outdoor Gear", "Camping & Hiking", "Camp Bedding", "Sleeping Pads"]], "price": 10.62}}
{"item_id": "B00069POHY", "title": "Firepow'r 5-Shot Pellet Clips", "description": "The Firpow'r kit includes four 5 shot pellet clips for Crosman 760 Pumpmaster, Recruit, 66 Powermaster, 7781 and M4-177 air rifles. Compatible with guns manufactured from 2002-current.", "text": "Firepow'r 5-Shot Pellet Clips The Firpow'r kit includes four 5 shot pellet clips for Crosman 760 Pumpmaster, Recruit, 66 Powermaster, 7781 and M4-177 air rifles. Compatible with guns manufactured from 2002-current.", "image_url": "http://ecx.images-amazon.com/images/I/41kG7pqb7XL._SX300_.jpg", "image_path": "data/images/sports/B00069POHY.jpg", "metadata": {"brand": "Crosman", "categories": [["Sports & Outdoors", "Paintball & Airsoft", "Airsoft", "Pellets"]], "price": 5.95}}
