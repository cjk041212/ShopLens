{"item_id": "B007D3OBHK", "title": "AR15 AR 15 Front and Rear flip up 45 Degree Rapid Transition BUIS Backup Iron Sight", "description": "This competition rapid transition flip up sight allows you to transition seamlessly between your primary optics and your backup iron sight.", "text": "AR15 AR 15 Front and Rear flip up 45 Degree Rapid Transition BUIS Backup Iron Sight This competition rapid transition flip up sight allows you to transition seamlessly between your primary optics and your backup iron sight.", "image_url": "http://ecx.images-amazon.com/images/I/41rUzN6FzaL._SY300_.jpg", "image_path": "data/images/sports/B007D3OBHK.jpg", "metadata": {"brand": "FieldSport", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Hunting Optics", "Gun Sights", "Iron Sights"]], "price": 19.55}}
