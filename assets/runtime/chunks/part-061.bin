-amazon.com/images/I/41QFc9MurSL._SY300_.jpg", "image_path": "data/images/sports/B00CBT17IW.jpg", "metadata": {"categories": [["Sports & Outdoors", "Exercise & Fitness", "Strength Training Equipment", "Pushup Stands"]]}}
