{"item_id": "B00CU9U8QU", "title": "SKLZ Dry-Erase Coaches' Board", "description": "Keep track of all your offensive, defensive and special teams plays on one board. Use the whole field view on one side for special teams and a close up field view on the other side for offensive and defensive plays.", "text": "SKLZ Dry-Erase Coaches' Board Keep track of all your offensive, defensive and special teams plays on one board. Use the whole field view on one side for special teams and a close up field view on the other side for offensive and defensive plays.", "image_url": "http://ecx.images-amazon.com/images/I/41z-kzEB1aL._SX300_.jpg", "image_path": "data/images/sports/B00CU9U8QU.jpg", "metadata": {"brand": "SKLZ", "categories": [["Sports & Outdoors", "Team Sports", "Football", "Accessories"]], "price": 26.95}}
{"item_id": "B00CU9U93W", "title": "SKLZ Heavy Duty 4-in-1 Universal Kicking Tee", "description": "The Universal Kicking Tee is perfect for high school and collegiate play. You can adjust the tee for any level of play because there are multiple height options allowing the kicker to gradually transition towards kicking off the ground.", "text": "SKLZ Heavy Duty 4-in-1 Universal Kicking Tee The Universal Kicking Tee is perfect for high school and collegiate play. You can adjust the tee for any level of play because there are multiple height options allowing the kicker to gradually transition towards kicking off the ground.", "image_url": "http://ecx.images-amazon.com/images/I/3171bjdXZ0L._SX300_.jpg", "image_path": "data/images/sports/B00CU9U93W.jpg", "metadata": {"brand": "SKLZ", "categories": [["Sports & Outdoors", "Team Sports", "Football", "Accessories", "Kicking Holders & Tees"]], "price": 19.99}}
