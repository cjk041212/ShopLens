age_url": "http://ecx.images-amazon.com/images/I/51WyuVoz4BL._SY300_.jpg", "image_path": "data/images/sports/B00FZVFOM8.jpg", "metadata": {"categories": [["Sports & Outdoors", "Cycling", "Lights & Reflectors", "Headlights"]], "price": 12.77}}
