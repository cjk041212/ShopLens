{"item_id": "B0083ZZGP8", "title": "Mossy Oak Roxie Women's Shooting Glass, Pink/Clear", "description": "Mossy Oak Roxie Womens Shooting Glasses feature an adjustable nose piece and ratcheting temples. Exceeds ANSI high impact standards. Filters 99% of harmful UV rays. Includes a bonus pair of pink shooting ear plugs. Comes in rose lenses and pink temples.", "text": "Mossy Oak Roxie Women's Shooting Glass, Pink/Clear Mossy Oak Roxie Womens Shooting Glasses feature an adjustable nose piece and ratcheting temples. Exceeds ANSI high impact standards. Filters 99% of harmful UV rays. Includes a bonus pair of pink shooting ear plugs. Comes in rose lenses and pink temples.", "image_url": "http://ecx.images-amazon.com/images/I/31D3rR6jjJL._SY300_.jpg", "image_path": "data/images/sports/B0083ZZGP8.jpg", "metadata": {"brand": "Mossy Oak Hunting Accessories", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Eyewear & Hearing Protection", "Safety Glasses"]], "price": 9.92}}
{"item_id": "B0083ZZH2U", "title": "Mossy Oak Lula Women's Shooting Muff, Pink", "description": "Mossy Oak Lula Women's Shooting Muffs are compact, easy folding shooting muffs. Soft foam ear cups. Adjustable to all sizes. NRRrating 31.", "text": "Mossy Oak Lula Women's Shooting Muff, Pink Mossy Oak Lula Women's Shooting Muffs are compact, easy folding shooting muffs. Soft foam ear cups. Adjustable to all sizes. NRRrating 31.", "image_url": "http://ecx.images-amazon.com/images/I/41smzqwiJwL._SY300_.jpg", "image_path": "data/images/sports/B0083ZZH2U.jpg", "metadata": {"brand": "Mossy Oak Hunting Accessories", "categories": [["Sports & Outdoors", "Hunting & Fishing", "Hunting", "Eyewear & Hearing Protection", "Earmuffs"]], "price": 20.31}}
